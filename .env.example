# Generate each separately: openssl rand -hex 32
APP_PASSWORD=
APP_SECRET_KEY=
# Set to 1 when accessed over HTTPS through your reverse proxy.
COOKIE_SECURE=0
# Number of reverse proxies that append to X-Forwarded-For (usually 1 behind a proxy).
# Leave at 0 when clients connect directly; see README.
TRUSTED_PROXY_HOPS=0
