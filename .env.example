# Generate each separately: openssl rand -hex 32
APP_PASSWORD=
APP_SECRET_KEY=
# Set to 1 when accessed over HTTPS through your reverse proxy.
COOKIE_SECURE=0
# Number of reverse proxies that append to X-Forwarded-For (usually 1 behind a proxy).
# Leave at 0 when clients connect directly; see README.
TRUSTED_PROXY_HOPS=0
# Optional AI assistance, off by default; see "AI assistance" in README.md.
# Readers must also switch it on in Preferences.
#
# AI_PROVIDER is off, anthropic, openai, ollama, or custom:
#   anthropic / openai  hosted APIs; bring your own key.
#   ollama              a local Ollama server; no key needed.
#   custom              any OpenAI-compatible server (LM Studio, vLLM,
#                       llama.cpp, LocalAI, or a gateway).
# AI_PROVIDER=off
# AI_API_KEY=                 # required for anthropic/openai; optional otherwise
# AI_MODEL=                   # required. Checked 2026-10-13: claude-opus-5-5 (anthropic),
#                             # gpt-6-astra (openai); for ollama, any pulled model such
#                             # as llama3.1:8b; for custom, the name your server lists.
# AI_BASE_URL=                # ollama: default http://127.0.0.1:11434; with the Compose
#                             # profile use http://ollama:11434, or for Ollama on this
#                             # computer http://host.docker.internal:11434.
#                             # custom: the API root, e.g. http://127.0.0.1:1234/v1.
#                             # Plain http:// is only accepted for local/private hosts.
# AI_TIMEOUT_SECONDS=60       # 5 to 600; raise it for slow local models
# AI_MAX_MONTHLY_REQUESTS=100
