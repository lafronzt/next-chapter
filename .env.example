# Generate each separately: openssl rand -hex 32
APP_PASSWORD=
APP_SECRET_KEY=
# Set to 1 when accessed over HTTPS through your reverse proxy.
COOKIE_SECURE=0
# Number of reverse proxies that append to X-Forwarded-For (usually 1 behind a proxy).
# Leave at 0 when clients connect directly; see README.
TRUSTED_PROXY_HOPS=0
# Optional AI assistance, off by default; see "AI assistance" in README.md.
# Readers must also switch it on in Preferences. Bring your own key.
# AI_PROVIDER=off            # off, anthropic, or openai
# AI_API_KEY=
# Model names checked 2026-10-13: claude-opus-5-5 (anthropic), gpt-6-astra (openai).
# AI_MODEL=
# AI_MAX_MONTHLY_REQUESTS=100
